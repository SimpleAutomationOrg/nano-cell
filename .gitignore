.DS_Store
node_modules/
runs/
out/
dist/
__pycache__/
.vscode/

# what the user attaches in the chat (photos, CAD, datasheets): kept local
applications/*/materials/

# applications replaced by an import are kept here, not deleted
.backups/

# conversations with the agents: kept with the application on this machine
applications/*/chats/
# the agents' CLI sessions, and which model each option is here: local to this machine
.chat-sessions.json
.chat-models.json

# this computer's own published app, when it is not the project author's (publish-app skill)
artifact.local.json

# scratch output of the artifact build test
dist-test-*

# the running server's port, and pictures of runs the agent asked for
.server.json
.runs/
