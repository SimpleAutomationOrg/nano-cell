{
 "name": "case assembly",
 "about": "An application: everything that belongs to one job and its environment — the grippers, the tool rack, the fixtures and parts on the table, and the steps (steps/). Every pose is in the table frame, so the application does not depend on which robot runs it; 'robot' names the one it is set up on now. What was taught in joint space on a particular robot is kept apart under 'taught_on' and has to be taught again on another robot.",
 "robot": "cell_fr3",
 "units": "metres, radians",
 "conventions": {
  "rpy": "fixed-axis roll, pitch, yaw: R = Rz(yaw) . Ry(pitch) . Rx(roll) (as URDF); a pose maps the item's frame into its parent",
  "mesh_frame": "each mesh is in the frame its pose places (flange frame for the flange stack and tools, the fixture's or part's own frame otherwise): metres, z up. GLB vertex data is stored in that frame as is (NOT turned to glTF's y-up).",
  "collision_stl": "metres, same frame as the GLB; every connected component is one convex piece",
  "table": "breadboard frame: origin at the lattice corner the cell calls (0, 0), x and y along the hole lattice, z up from the plate top"
 },
